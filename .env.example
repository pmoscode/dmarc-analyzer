# Template for docker-compose.yml — copy to ".env" and fill in.
# Full reference (required/default/meaning per variable):
# docs/features/deployment.md
#
# .env itself must NEVER go into Git (see .gitignore) — it holds secrets.

# --- IMAP account (required) ---
DMARC_IMAP_HOST=imap.example.com
DMARC_IMAP_PORT=993
DMARC_IMAP_USER=dmarc@example.com
DMARC_IMAP_PASSWORD=changeme
DMARC_IMAP_MAILBOX=INBOX
DMARC_IMAP_TLS=true

# --- Retention/background sync (optional, defaults see deployment.md) ---
DMARC_RETENTION_MONTHS=24
DMARC_SYNC_INTERVAL_MINUTES=60

# --- OIDC/Authentik login (required) ---
DMARC_OIDC_ISSUER_URL=https://authentik.example.com/application/o/dmarc/
DMARC_OIDC_CLIENT_ID=dmarc-analyzer
DMARC_OIDC_CLIENT_SECRET=changeme
DMARC_OIDC_REDIRECT_URL=https://dmarc.example.com/anmelden/callback
DMARC_OIDC_ADMIN_GROUP=dmarc-admins
# For DEV only, with a self-signed certificate (e.g. Caddy's "tls internal") —
# never set this to true in production, see deployment.md.
DMARC_OIDC_INSECURE_SKIP_VERIFY=false
