# Werte für lokales Testen mit docker-compose.override.yml (Caddy +
# Mock-IdP statt echtem Authentik) — NICHT für Produktion.
# Für den echten Betrieb: .env.example.
#
# cp .env.local.example .env && docker compose up --build

# --- IMAP-Konto (Pflicht, aber Platzhalter reichen — für den Login-Test
# wird kein echtes Postfach angesprochen) ---
DMARC_IMAP_HOST=imap.example.com
DMARC_IMAP_PORT=993
DMARC_IMAP_USER=dmarc@example.com
DMARC_IMAP_PASSWORD=platzhalter
DMARC_IMAP_MAILBOX=INBOX
DMARC_IMAP_TLS=true

# --- Aufbewahrung/Hintergrund-Sync (0 = kein automatischer Sync gegen
# den Platzhalter-IMAP-Host) ---
DMARC_RETENTION_MONTHS=24
DMARC_SYNC_INTERVAL_MINUTES=0

# --- OIDC gegen den Mock-IdP (siehe mock-idp/clients.json, users.json) ---
DMARC_OIDC_ISSUER_URL=https://idp.localtest.me
DMARC_OIDC_CLIENT_ID=dmarc-analyzer
DMARC_OIDC_CLIENT_SECRET=local-test-secret
DMARC_OIDC_REDIRECT_URL=https://dmarc.localtest.me/anmelden/callback
DMARC_OIDC_ADMIN_GROUP=dmarc-admins
