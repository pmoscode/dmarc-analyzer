# Values for local testing with docker-compose.override.yml (Caddy +
# mock IdP instead of a real Authentik) — NOT for production.
# For real deployments: .env.example.
#
# cp .env.local.example .env && docker compose up --build

# --- IMAP account (required, but placeholders are fine — the login test
# never talks to a real mailbox) ---
DMARC_IMAP_HOST=imap.example.com
DMARC_IMAP_PORT=993
DMARC_IMAP_USER=dmarc@example.com
DMARC_IMAP_PASSWORD=placeholder
DMARC_IMAP_MAILBOX=INBOX
DMARC_IMAP_TLS=true

# --- Retention/background sync (0 = no automatic sync against the
# placeholder IMAP host) ---
DMARC_RETENTION_MONTHS=24
DMARC_SYNC_INTERVAL_MINUTES=0

# --- OIDC against the mock IdP (see mock-idp/clients.json, users.json) ---
DMARC_OIDC_ISSUER_URL=https://idp.localtest.me
DMARC_OIDC_CLIENT_ID=dmarc-analyzer
DMARC_OIDC_CLIENT_SECRET=local-test-secret
DMARC_OIDC_REDIRECT_URL=https://dmarc.localtest.me/anmelden/callback
DMARC_OIDC_ADMIN_GROUP=dmarc-admins
